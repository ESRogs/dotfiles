[user]
	name = ESRogs
	email = esrogs@gmail.com
[alias]
    co = checkout
    cor = checkout
    cp = cherry-pick
    dd = difftool -y
    ff = merge --ff-only
    gg = fetch --all --prune
    l = log --oneline --graph --branches --tags --remotes --not --remotes="*/gh-pages" --pretty=format:\"%x09%C(auto)%h %C(blue bold)%ai %>(14)%C(reset)%C(magenta bold ul)%ar%Creset %>(10,mtrunc)%C(yellow bold)%an%C(auto) %s %d\"
    ll = log --decorate --graph --shortstat --branches --tags --remotes --not --remotes="*/gh-pages"
    mm = mergetool
    pp = mergetool --tool p4
    st = status
    unstage = reset HEAD
    ra = "!f() { git remote -v | grep origin | grep fetch | sed 's/origin\\s\\+//' | sed 's/ \\(.*\\)//' | sed \"s/:[^/]\\+/:$1/\" | xargs -I % git remote add $1 %; }; f"
    rr = "!f() { git branch --merged | grep -v -e master -e \\* | xargs -I % git branch -d %; }; f"
    biggest = "!f() { git rev-list --objects --all | git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | awk '/^blob/ {print substr($0,6)}' | sort --numeric-sort --key=2 | cut --complement --characters=13-40 | numfmt --field=2 --to=iec-i --suffix=B --padding=7 --round=nearest; }; f"
    patch = commit --amend --no-edit
    pr = "!f() { hub pull-request $@; }; f"
    ci = "!f() { hub ci-status $@; }; f"
    poke = "commit --amend --no-edit --reset-author"
    rbc = rebase --continue
[push]
	autoSetupRemote = true
